node_modules/
# Also match a bare `node_modules` SYMLINK: the trailing-slash pattern above only
# matches a real directory, so a symlinked node_modules would otherwise be staged.
node_modules
dist/
.env
.env.*
.DS_Store
*.log

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Test coverage output
coverage/

# Agent scratch space: working drafts, generated HTML, one-off scripts.
.scratch/
