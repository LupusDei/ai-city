{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    // Pinned explicitly: tsc otherwise infers rootDir from the common source
    // directory, so adding a second top-level folder under src/ would silently
    // relocate every emitted path (dist/grid.js -> dist/sim/grid.js).
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*.ts"]
}
